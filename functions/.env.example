# يُستخدم عند نشر Cloud Functions (لا ترفعي القيم الحقيقية إلى Git).
# انسخي سطر ADMIN_UIDS من ملف .env في جذر المشروع إلى هنا، أو عيّني نفس القيمة في Google Cloud.
# الملف المرجعي الرئيسي للمشروع هو: ../.env
ADMIN_UIDS=

# أكواد التفعيل (اختياري — يُقرأ أيضًا من متغيرات بيئة السحابة عند النشر)
# PROMO_CODES=CODE1,CODE2
