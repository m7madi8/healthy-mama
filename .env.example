# ===========================================
# إعدادات الموقع — انسخ هذا الملف إلى .env
# واملأ القيم الحقيقية. لا ترفع ملف .env إلى Git.
# ===========================================

# الباي بال — إيميل الحساب الذي يستقبل المدفوعات
PAYPAL_BUSINESS=your-email@example.com

# بيئة الباي بال: live للإنتاج ، sandbox للاختبار
PAYPAL_ENV=live

# واتساب — الرابط الكامل (مثال: https://wa.me/972521234567)
WHATSAPP_URL=https://wa.me/972501234567

# إنستغرام — الرابط الكامل لحسابك (مثال: https://instagram.com/username)
INSTAGRAM_URL=https://instagram.com

# كلمة سر لوحة التحكم (admin) — الافتراضي healthy2025 إن لم تُحدّدي هنا
ADMIN_PASSWORD=healthy2025nawalaom123

# (اختياري) نموذج التواصل — إن استخدمت Formspree ضع الرابط هنا
# CONTACT_FORM_ACTION=https://formspree.io/f/YOUR_FORM_ID

# -------------------------------------------
# طريقة الاستخدام:
# 1. انسخ هذا الملف: cp .env.example .env
# 2. افتح .env واملأ القيم الحقيقية
# 3. شغّل: node build-env.js  (يولّد env.js)
# 4. تأكد أن .env و env.js مضافان في .gitignore ولا ترفعهما إلى Git
