# ===========================================
# المصدر المعتمد للإعدادات: ملف  .env  في جذر المشروع (لا يُرفع إلى Git).
# .env.example  مجرد قالب: انسخيه إلى  .env  ثم عُدّلي القيم هناك؛ التطبيق يقرأ من  .env  عبر Vite.
# المتغيرات التي يصلها المتصفح يجب أن تبدأ بـ VITE_
# على Vercel وغيرها: انسخي نفس أسماء المفاتيح وقيمها من  .env  إلى متغيرات المشروع (لا تعتمدي على Git لنقل الأسرار).
# ===========================================

# الباي بال — إيميل الحساب الذي يستقبل المدفوعات
VITE_PAYPAL_BUSINESS=your-email@example.com

# بيئة الباي بال: live للإنتاج ، sandbox للاختبار
VITE_PAYPAL_ENV=live

# رابط Webhook الخاص بـ PayPal IPN (Cloud Function)
# مثال: https://us-central1-your-project.cloudfunctions.net/paypalIpnWebhook
VITE_PAYPAL_NOTIFY_URL=

# كود الخصم (اختياري)
# مثال: MAMA20
VITE_DISCOUNT_CODE=
# نسبة الخصم (0 - 100)
VITE_DISCOUNT_PERCENT=0

# Promo code redeem (اختياري — يحتاج خطة Blaze لنشر Cloud Functions)
# بدون Blaze: زر «الحصول على الكتاب مجانًا» يستخدم Firestore من المتصفح + قواعد firestore.rules
VITE_ENABLE_PROMO=false
# مثال: https://us-central1-your-project.cloudfunctions.net/redeemPromoCode
VITE_PROMO_REDEEM_URL=

# واتساب — الرابط الكامل (مثال: https://wa.me/972521234567)
VITE_WHATSAPP_URL=https://wa.me/972501234567

# إنستغرام — الرابط الكامل لحسابك
VITE_INSTAGRAM_URL=https://instagram.com

# لوحة المالك (/admin): دخول بحساب Google + Cloud Functions
# إقليم الدوال (يطابق النشر، غالبًا us-central1)
VITE_FIREBASE_FUNCTIONS_REGION=us-central1
# للمطورين مع المحاكي: VITE_USE_FUNCTIONS_EMULATOR=true

# معرّف (أو أكثر) لحساب المالك في Firebase Auth — مفصولة بفاصلة
# ضعيها هنا في .env للمرجع؛ عند firebase deploy --only functions يجب أن تكون
# نفس القيمة موجودة أيضًا في functions/.env (أو في متغيرات بيئة الدالة بالسحابة)
ADMIN_UIDS=

# (قديم) كلمة سر لوحة محلية — لم تعد مستخدمة
# VITE_ADMIN_PASSWORD=healthy2025

# (اختياري) Formspree — رابط النموذج لإرسال التواصل من الصفحة الرئيسية
# VITE_CONTACT_FORM_ACTION=https://formspree.io/f/YOUR_FORM_ID

# رابط التطبيق (اختياري) لتكوين Return URL بشكل ثابت
# VITE_APP_URL=https://your-domain.com

# Firebase (عميل React)
# بعد النشر: انشري أيضًا firestore:indexes (فهرس collectionGroup على library.status)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# -------------------------------------------
# النشر على Vercel (مهم)
# المعتمد محليًا هو  .env — على Vercel انسخي منه نفس مفاتيح VITE_* (القيم كما في ملفك المعتمد):
# Dashboard → Project → Settings → Environment Variables
# أضيفي كل المتغيرات التي تبدأ بـ VITE_ (نفس القيم من .env المحلي)، على الأقل:
#   VITE_FIREBASE_API_KEY, VITE_FIREBASE_AUTH_DOMAIN, VITE_FIREBASE_PROJECT_ID,
#   VITE_FIREBASE_APP_ID (+ VITE_FIREBASE_STORAGE_BUCKET و VITE_FIREBASE_MESSAGING_SENDER_ID إن وُجدتا)
# وكذلك PayPal، الواتساب، الخصم، VITE_FIREBASE_FUNCTIONS_REGION، إلخ حسب استخدامك.
# بعد الحفظ: أعيدي نشرًا (Redeploy) حتى يُبنى dist بالقيم الجديدة.
# في Firebase Console → Authentication → Settings → Authorized domains أضيفي نطاقك (مثل xxx.vercel.app).
# -------------------------------------------
# الاستخدام:
# 1. أنشئي الملف الحقيقي: انسخي .env.example إلى الاسم  .env
# 2. npm install
# 3. npm run dev — للتطوير
# 4. npm run build — يُخرج مجلد dist/
#
# النشر (SPA): وجّه كل المسارات إلى index.html
# - Netlify: يُستخدم public/_redirects تلقائيًا
# - Vercel: أضف في vercel.json { "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }] }
# - GitHub Pages: عيّن base في vite.config.ts لمسار المستودع أو استخدم HashRouter
